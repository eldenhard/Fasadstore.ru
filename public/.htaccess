DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Preserve indexed WordPress URLs after moving to the new site.
RewriteRule ^Продукция/окна-alutech-алютех-2/?$ https://fasadstore.ru/windows/classic/ [R=301,L]
RewriteRule ^Продукция/алюминиевые-окна/?$ https://fasadstore.ru/windows/ [R=301,L]
RewriteRule ^Продукция/aluminievye-dveri/?$ https://fasadstore.ru/doors/ [R=301,L]
RewriteRule ^Продукция/razdvizhnye-dveri-alutech/?$ https://fasadstore.ru/sliding-doors/ [R=301,L]
RewriteRule ^Продукция/razdvizhnye-dveri-alutech-2/?$ https://fasadstore.ru/sliding-doors/ [R=301,L]
RewriteRule ^Продукция/razdvizhnye-dveri/?$ https://fasadstore.ru/sliding-doors/ [R=301,L]
RewriteRule ^Продукция/остекление-коттеджей/?$ https://fasadstore.ru/cottages/ [R=301,L]
RewriteRule ^Продукция/vidy-stekla-i-steklopaketov-dizajner/?$ https://fasadstore.ru/facades/ [R=301,L]

# Beget serves Apache behind an HTTPS proxy; keep directory redirects on HTTPS.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ https://fasadstore.ru/$1/ [R=301,L]
